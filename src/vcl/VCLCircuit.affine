// Ported via Harvard Engine (Semantic pass)

module VCLCircuit;

// SPDX-License-Identifier: MPL-2.0
// VCL Circuit DSL — Defines structs for custom ZKP circuits in VCL.
//
// Usage in VCL:
//   PROOF CUSTOM "circuit-name" WITH (threshold=0.5, min_score=0.1)

/// Gate structs available in custom circuits
struct gateType {
  | AND
  | OR
  | XOR
  | NOT
  | LinearCombination

/// A wire in the circuit (carries a signal)
struct wire { {
  name: string,
  isPublic: bool,
  isOutput: bool,
}

/// A gate connecting input wires to an output wire
struct gate { {
  gateType: gateType,
  inputs: array<string>,
  output: string,
}

/// A constraint in the circuit (R1CS: A * B = C)
struct constraint { {
  description: string,
  a: array<(int, float)>,
  b: array<(int, float)>,
  c: array<(int, float)>,
}

/// A circuit definition from VCL PROOF CUSTOM clause
struct circuitDef { {
  name: string,
  wires: array<wire>,
  gates: array<gate>,
  parameters: array<string>,
}

/// Parameters passed via VCL WITH clause
struct circuitParams { {
  values: Js.Dict.t<string>,
}

/// Result of a custom circuit verification
struct verificationResult { {
  circuitName: string,
  verified: bool,
  publicInputs: array<float>,
  constraintsSatisfied: int,
  totalConstraints: int,
}

/// Parse a PROOF CUSTOM clause from VCL
fn parseCustomProof = (circuitName: string, withParams: array<(string, string)>): (string, circuitParams) => {
  fn dict = Js.Dict.empty()
  withParams->Array.forEach(((key, value)) => {
    Js.Dict.set(dict, key, value)
  })
  (circuitName, {values: dict})
}

/// Serialize a circuit definition to JSON for the Rust bridge
fn serializeCircuitDef = (def: circuitDef): string => {
  Js.Json.stringifyAny(def)->Option.getOr("{}")
}

