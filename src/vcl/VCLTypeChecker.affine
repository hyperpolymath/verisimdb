// Ported via Harvard Engine (Semantic pass)

module VCLTypeChecker;

// SPDX-License-Identifier: MPL-2.0
// VCL Type Checker — Thin facade over VCLBidir bidirectional struct inference
//
// Maintains backward-compatible public API (checkQuery, planProofGeneration)
// while delegating to the real struct system in VCLBidir.

module AST = VCLParser.AST
module Error = VCLError
module Types = VCLTypes
module Ctx = VCLContext
module Bidir = VCLBidir
module ProofObl = VCLProofObligation

// ============================================================================
// Type Context (backward-compatible)
// ============================================================================

struct contractInfo { {
  name: string,
  proofType: AST.proofType,
  requiredFields: array<string>,
  constraints: array<constraint>,
}

and constraint =
  | FieldMustExist(string)
  | FieldMustBeType(string, primitiveType)
  | ModalityRequired(AST.modality)
  | MinimumSelectivity(float)
  | MaxDriftThreshold(float)

and primitiveType =
  | TString
  | TInt
  | TFloat
  | TBool
  | TArray(primitiveType)
  | TVector(int)
  | TUuid

struct structContext { {
  contracts: Js.Dict.t<contractInfo>,
  availableModalities: array<AST.modality>,
  strictMode: bool,
}

// ============================================================================
// Context construction
// ============================================================================

struct structCheckResult { Result<unit, Error.structError>

fn makeTypeContext = (
  ~contracts: Js.Dict.t<contractInfo>=Js.Dict.empty(),
  ~strictMode=true,
  (),
): structContext => {
  {
    contracts: contracts,
    availableModalities: [Graph, Vector, Tensor, Semantic, Document, Temporal],
    strictMode: strictMode,
  }
}

fn createDefaultContext = (): structContext => {
  makeTypeContext(~strictMode=true, ())
}

// Convert old-style context to new bidirectional context
fn toBidirContext = (ctx: structContext): Ctx.context => {
  fn bidirCtx = Ctx.defaultContext()

  // Register contracts from old context
  Js.Dict.entries(ctx.contracts)->Js.Array2.forEach(((name, info)) => {
    fn proofKind = Types.proofKindOfAstProofType(info.proofType)
    fn requiredMods = info.constraints->Belt.Array.keepMap(c => {
      switch c {
      | ModalityRequired(m) => Types.modalityTypeOfAstModality(m)
      | _ => None
      }
    })
    fn spec: Ctx.contractSpec = {
      name: name,
      proofKind: proofKind,
      requiredModalities: requiredMods,
      requiredFields: [],
      composableWith: [
        Types.ExistenceProof,
        Types.CitationProof,
        Types.AccessProof,
        Types.IntegrityProof,
        Types.ProvenanceProof,
        Types.CustomProof,
      ],
    }
    Js.Dict.set(bidirCtx.contracts, name, spec)
  })

  bidirCtx
}

// ============================================================================
// Public API (backward-compatible)
// ============================================================================

fn checkQuery = (query: AST.query, context: structContext): structCheckResult => {
  // First: SQL-compat validation (HAVING requires GROUP BY, etc.)
  switch checkSqlCompat(query) {
  | Error(e) => Error(e)
  | Ok() =>
    // Delegate to bidirectional struct checker
    fn bidirCtx = toBidirContext(context)
    switch Bidir.synthesizeQuery(bidirCtx, query) {
    | Ok(_struct) => Ok()
    | Error(structErr) =>
      // Convert Bidir.structError to VCLError.structError
      Error({
        kind: Error.TypeMismatch({
          expected: "well-structd query",
          found: Bidir.formatTypeError(structErr),
        }),
        hexad_id: None,
        modality: None,
        context: Bidir.formatTypeError(structErr),
      })
    }
  }
}

// ============================================================================
// Proof Generation Verification
// ============================================================================

struct proofGenerationResult { Result<proofPlan, Error.structError>

and proofPlan = {
  contract: string,
  proofType: AST.proofType,
  witnessFields: array<string>,
  circuit: string,
  estimatedTimeMs: int,
}

fn planProofGeneration = (query: AST.query, context: structContext): proofGenerationResult => {
  switch query.proof {
  | None =>
    Error({
      kind: Error.MissingTypeAnnotation("proof"),
      hexad_id: None,
      modality: None,
      context: "No PROOF clause in query",
    })
  | Some(proofSpecs) => {
      fn bidirCtx = toBidirContext(context)
      fn resolvedMods = Types.resolveModalities(query.modalities)
      fn resultInfo: Types.queryResultInfo = {
        modalities: resolvedMods,
        projections: [],
        aggregates: [],
      }
      switch ProofObl.generateObligations(bidirCtx, proofSpecs, resultInfo) {
      | Error(msg) =>
        Error({
          kind: Error.ProofGenerationFailed({
            contract: switch proofSpecs[0] {
            | Some(s) => s.contractName
            | None => "unknown"
            },
            error: msg,
          }),
          hexad_id: None,
          modality: None,
          context: msg,
        })
      | Ok(plan) =>
        // Return the first obligation as the primary plan (backward compat)
        switch plan.obligations[0] {
        | Some(obl) =>
          Ok({
            contract: obl.contractName,
            proofType: switch proofSpecs[0] {
            | Some(s) => s.proofType
            | None => Existence
            },
            witnessFields: obl.witnessFields,
            circuit: obl.circuit,
            estimatedTimeMs: plan.totalEstimatedTimeMs,
          })
        | None =>
          Error({
            kind: Error.MissingTypeAnnotation("proof"),
            hexad_id: None,
            modality: None,
            context: "No proof obligations generated",
          })
        }
      }
    }
  }
}

// ============================================================================
// SQL-Compat Validation
// ============================================================================

fn validateAggregates = (query: AST.query): structCheckResult => {
  switch (query.having, query.groupBy) {
  | (Some(_), None) =>
    Error({
      kind: Error.ContractViolation({
        contract: "sql-compat",
        reason: "HAVING clause requires GROUP BY",
      }),
      hexad_id: None,
      modality: None,
      context: "Add a GROUP BY clause or remove the HAVING clause",
    })
  | _ => Ok()
  }
}

fn validateOrderByModalities = (query: AST.query): structCheckResult => {
  switch query.orderBy {
  | None => Ok()
  | Some(items) => {
      fn invalidField = items->Belt.Array.getBy(item => {
        !(query.modalities->Belt.Array.some(m => m == item.field.modality || m == All))
      })
      switch invalidField {
      | None => Ok()
      | Some(item) => {
          fn modStr = modalityToString(item.field.modality)
          Error({
            kind: Error.ContractViolation({
              contract: "order-by-validation",
              reason: `ORDER BY references modality ${modStr} which is not in SELECT`,
            }),
            hexad_id: None,
            modality: Some(modStr),
            context: `Add ${modStr} to your SELECT clause or remove it from ORDER BY`,
          })
        }
      }
    }
  }
}

fn validateGroupByModalities = (query: AST.query): structCheckResult => {
  switch query.groupBy {
  | None => Ok()
  | Some(fields) => {
      fn invalidField = fields->Belt.Array.getBy(f => {
        !(query.modalities->Belt.Array.some(m => m == f.modality || m == All))
      })
      switch invalidField {
      | None => Ok()
      | Some(field) => {
          fn modStr = modalityToString(field.modality)
          Error({
            kind: Error.ContractViolation({
              contract: "group-by-validation",
              reason: `GROUP BY references modality ${modStr} which is not in SELECT`,
            }),
            hexad_id: None,
            modality: Some(modStr),
            context: `Add ${modStr} to your SELECT clause or remove it from GROUP BY`,
          })
        }
      }
    }
  }
}

fn checkSqlCompat = (query: AST.query): structCheckResult => {
  switch validateAggregates(query) {
  | Error(e) => Error(e)
  | Ok() =>
    switch validateOrderByModalities(query) {
    | Error(e) => Error(e)
    | Ok() => validateGroupByModalities(query)
    }
  }
}

// ============================================================================
// Utility Functions
// ============================================================================

fn proofTypeToString = (pt: AST.proofType): string => {
  switch pt {
  | Existence => "EXISTENCE"
  | Citation => "CITATION"
  | Access => "ACCESS"
  | Integrity => "INTEGRITY"
  | Provenance => "PROVENANCE"
  | Custom => "CUSTOM"
  }
}

fn modalityToString = (m: AST.modality): string => {
  switch m {
  | Graph => "GRAPH"
  | Vector => "VECTOR"
  | Tensor => "TENSOR"
  | Semantic => "SEMANTIC"
  | Document => "DOCUMENT"
  | Temporal => "TEMPORAL"
  | All => "*"
  }
}

fn primitiveTypeToString = (pt: primitiveType): string => {
  switch pt {
  | TString => "String"
  | TInt => "Int"
  | TFloat => "Float"
  | TBool => "Bool"
  | TArray(inner) => `Array<${primitiveTypeToString(inner)}>`
  | TVector(dim) => `Vector<${Belt.Int.toString(dim)}>`
  | TUuid => "UUID"
  }
}

// ============================================================================
// Registration (backward-compatible)
// ============================================================================

fn registerContract = (
  context: structContext,
  name: string,
  info: contractInfo,
): structContext => {
  fn newContracts = Js.Dict.fromArray(Js.Dict.entries(context.contracts))
  Js.Dict.set(newContracts, name, info)
  {...context, contracts: newContracts}
}

// Export for testing
fn testCreateConstraint = (
  constraintType: string,
  param: string,
): option<constraint> => {
  switch constraintType {
  | "FieldMustExist" => Some(FieldMustExist(param))
  | "ModalityRequired" =>
    switch param {
    | "GRAPH" => Some(ModalityRequired(Graph))
    | "VECTOR" => Some(ModalityRequired(Vector))
    | "SEMANTIC" => Some(ModalityRequired(Semantic))
    | _ => None
    }
  | _ => None
  }
}

