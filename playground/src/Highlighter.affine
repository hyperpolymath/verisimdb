// Ported via Harvard Engine (Semantic pass)

module Highlighter;

// SPDX-License-Identifier: MPL-2.0
// VCL syntax highlighting for the playground editor.
// Produces HTML spans with CSS classes for keyword colouring.

fn highlightVcl = (text: string, ~vclDt: bool=false): string => {
  fn result = ref("")
  fn chars = String.split(text, "")
  fn len = Array.length(chars)
  fn i = ref(0)

  while i.contents < len {
    fn ch = chars[i.contents]->Option.getOr("")

    // String literals
    if ch == "'" || ch == "\"" {
      fn quote = ch
      fn start = i.contents
      i := i.contents + 1
      while i.contents < len && chars[i.contents]->Option.getOr("") != quote {
        if chars[i.contents]->Option.getOr("") == "\\" {
          i := i.contents + 1
        }
        i := i.contents + 1
      }
      if i.contents < len {
        i := i.contents + 1
      }
      fn slice = String.slice(text, ~start, ~end=i.contents)
      result := result.contents ++ `<span class="str">${slice}</span>`
    }
    // Comments (-- single line)
    else if ch == "-" && i.contents + 1 < len && chars[i.contents + 1]->Option.getOr("") == "-" {
      fn start = i.contents
      while i.contents < len && chars[i.contents]->Option.getOr("") != "\n" {
        i := i.contents + 1
      }
      fn slice = String.slice(text, ~start, ~end=i.contents)
      result := result.contents ++ `<span class="cmt">${slice}</span>`
    }
    // Words
    else if Js.Re.test_(%re("/[a-zA-Z_]/"), ch) {
      fn start = i.contents
      while i.contents < len && Js.Re.test_(%re("/[a-zA-Z0-9_]/"), chars[i.contents]->Option.getOr("")) {
        i := i.contents + 1
      }
      fn word = String.slice(text, ~start, ~end=i.contents)
      fn upper = String.toUpperCase(word)

      if VclKeywords.isModality(upper) {
        result := result.contents ++ `<span class="mod">${word}</span>`
      } else if VclKeywords.isProofType(upper) && vclDt {
        result := result.contents ++ `<span class="proof">${word}</span>`
      } else if VclKeywords.isKeyword(upper) {
        result := result.contents ++ `<span class="kw">${word}</span>`
      } else {
        result := result.contents ++ word
      }
    }
    // Numbers
    else if Js.Re.test_(%re("/[0-9]/"), ch) {
      fn start = i.contents
      while i.contents < len && Js.Re.test_(%re("/[0-9.]/"), chars[i.contents]->Option.getOr("")) {
        i := i.contents + 1
      }
      fn num = String.slice(text, ~start, ~end=i.contents)
      result := result.contents ++ `<span class="num">${num}</span>`
    }
    // Everything else
    else {
      // HTML-escape < > &
      fn escaped = switch ch {
      | "<" => "&lt;"
      | ">" => "&gt;"
      | "&" => "&amp;"
      | c => c
      }
      result := result.contents ++ escaped
      i := i.contents + 1
    }
  }

  result.contents
}

