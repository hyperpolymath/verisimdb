# Coq build oracle for VeriSimDB formal proofs.
# Follows the Ephapax pattern (hyperpolymath/ephapax formal/Justfile).
#
# Local use:
#   just -f formal/Justfile all
#   just -f formal/Justfile check-assumptions
#   just -f formal/Justfile clean

COQC := "coqc"

# Compile every proof module.
all: provenance drift transaction planner wal normalizer vcl planner-semantic

# --- Per-module compile recipes -------------------------------------------

provenance:
    {{COQC}} -q Provenance.v | tee Provenance.out

drift:
    {{COQC}} -q Drift.v | tee Drift.out

transaction:
    {{COQC}} -q Transaction.v | tee Transaction.out

planner:
    {{COQC}} -q Planner.v | tee Planner.out

wal:
    {{COQC}} -q WAL.v | tee WAL.out

normalizer:
    {{COQC}} -q Normalizer.v | tee Normalizer.out

vcl:
    {{COQC}} -q VCL.v | tee VCL.out

planner-semantic:
    {{COQC}} -q PlannerSemantic.v | tee PlannerSemantic.out

# --- Whitelist guards -----------------------------------------------------
# Each module declares its own set of Parameters/Axioms; the guard greps
# Print Assumptions output for any name outside that module's whitelist.

check-assumptions: check-provenance check-drift check-transaction check-planner check-wal check-normalizer check-vcl check-planner-semantic

check-provenance: provenance
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' Provenance.out \
      | sort -u \
      | grep -vE '^(content|hash|sha256|genesis_hash|sha256_collision_resistant)$' \
      | { if read -r line; then \
            echo "ERROR(Provenance): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(Provenance): 3 theorems x 4 Parameters whitelisted"; \
          fi; }

check-drift: drift
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' Drift.out \
      | sort -u \
      | grep -vE '^(score|zero|one|le|clamp|le_refl|clamp_lower|clamp_upper|f_semantic_vector_drift|f_graph_document_drift|f_temporal_consistency_drift|f_tensor_drift|f_provenance_drift|f_spatial_drift|f_schema_drift|f_quality_drift|f_quality_drift_octad|f_detect_drift|strictly_greater|le_or_gt|le_gt_exclusive|detector_iff_threshold)$' \
      | { if read -r line; then \
            echo "ERROR(Drift): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(Drift): D1 (9 fns) + D2 (detector iff threshold) whitelisted"; \
          fi; }

check-transaction: transaction
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' Transaction.out \
      | sort -u \
      | { if read -r line; then \
            echo "ERROR(Transaction): expected 0 axioms, found: $line"; cat; exit 1; \
          else \
            echo "OK(Transaction): 3 theorems closed under global context (0 axioms)"; \
          fi; }

check-planner: planner
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' Planner.out \
      | sort -u \
      | grep -vE '^(modality|condition|optimize|optimize_is_permutation)$' \
      | { if read -r line; then \
            echo "ERROR(Planner): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(Planner): Q1-lite 3 theorems x 4 axioms whitelisted"; \
          fi; }

check-wal: wal
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' WAL.out \
      | sort -u \
      | grep -vE '^(entity_id|data|eq_entity_dec|functional_extensionality_dep)$' \
      | { if read -r line; then \
            echo "ERROR(WAL): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(WAL): C7 replay-idempotent + deterministic-off-touched"; \
          fi; }

check-normalizer: normalizer
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' Normalizer.out \
      | sort -u \
      | grep -vE '^(modality|modality_data|drifted|winner|winner_excludes_drifted|winner_stable_off_drifted|functional_extensionality_dep)$' \
      | { if read -r line; then \
            echo "ERROR(Normalizer): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(Normalizer): N2 idempotent + fills-drifted-when-winner"; \
          fi; }

check-vcl: vcl
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' VCL.out \
      | sort -u \
      | { if read -r line; then \
            echo "ERROR(VCL): expected 0 axioms, found: $line"; cat; exit 1; \
          else \
            echo "OK(VCL): V2 preservation + progress (0 axioms)"; \
          fi; }

check-planner-semantic: planner-semantic
    @awk '/^[A-Za-z_][A-Za-z0-9_]* :/ {print $1}' PlannerSemantic.out \
      | sort -u \
      | grep -vE '^(modality|condition|octad|exec_node|exec_node_comm|optimize|optimize_is_permutation)$' \
      | { if read -r line; then \
            echo "ERROR(PlannerSemantic): unexpected axiom: $line"; cat; exit 1; \
          else \
            echo "OK(PlannerSemantic): Q1-full semantic equivalence + membership"; \
          fi; }

# Remove all build artefacts.
clean:
    rm -f *.vo *.vos *.vok *.glob .*.aux *.out
