# SPDX-License-Identifier: MPL-2.0
# Dustfile - rollback and recovery semantics for VeriSimDB
#
# "Dust" = what's left when things break. This file names the canonical
# recovery procedures for each failure class.

version: 1

# ----------------------------------------------------------------------
# Recovery procedures
# ----------------------------------------------------------------------

procedures:

  - name: wal-replay
    when: "process crash or container restart"
    invariant: "C7 — wal_replay_idempotent on observable state (formal/WAL.v)"
    run:
      - "verisim-wal replay --data-dir $VERISIM_DATA_DIR"
      - "verify Print Assumptions for C7 stays at zero axioms"

  - name: drift-repair
    when: "drift score exceeds threshold (one or more modalities diverged from authoritative)"
    invariant: "N2 — normalize_idempotent (formal/VCL.v / Normalizer.v)"
    run:
      - "verisim-normalizer repair --entity-id <id> --authoritative <modality>"
      - "verify all 8 modalities converged via verisim-drift check"

  - name: provenance-chain-break
    when: "provenance hash-chain integrity check fails"
    invariant: "P2/P3 — append_preserves_verified + build_chain_all_verified (formal/Provenance.v)"
    run:
      - "verisim-provenance verify --entity-id <id>"
      - "if break confirmed, isolate from federation queries until chain rebuilt"

  - name: container-bundle-rollback
    when: "newly-signed .ctp bundle fails post-deployment verification"
    invariant: "stapeln attestation chain"
    run:
      - "cerro-torre verify --bundle <previous-good>.ctp"
      - "podman pull <previous-good> && podman tag <previous-good> verisimdb:latest"
      - "selur-compose restart"

  - name: cargo-deny-red
    when: "cargo deny check fails (advisories / bans / licenses / sources)"
    invariant: "deny.toml allow-list matches workspace license declaration"
    run:
      - "cargo deny check 2>&1 | tee /tmp/deny-output.txt"
      - "classify failure: advisory / license / banned-dep / unknown-source"
      - "if license: verify workspace Cargo.toml license vs LICENSE vs deny.toml allow-list (see issue #82 / PR #101 precedent)"
      - "DO NOT bulk-edit SPDX headers — manual per-file per feedback_no_automated_licence_edits"

  - name: federation-adapter-down
    when: "external backend unreachable (MongoDB / Redis / Neo4j / ClickHouse / SurrealDB / InfluxDB / MinIO)"
    invariant: "circuit-breaker pattern; queries fall back to direct-from-octad mode"
    run:
      - "check selur-compose stack: cd connectors/test-infra && selur-compose ps"
      - "if dev: selur-compose restart <service>"
      - "if prod: drift_monitor isolates the modality fed by that backend until reachable"

  - name: proof-axiom-slippage
    when: "Print Assumptions guard fails for a foundation-pack theorem"
    invariant: "P2/P3/D1/C2/C7/N2/V2/Q1 must assert zero new axioms"
    run:
      - "cd formal && coqc -Q . VeriSimDB <Module>.v"
      - "coqc -Q . VeriSimDB <Module>.v -compile <Module> | grep 'Axiom\\|admit'"
      - "if new axiom appeared, refuse to merge; review the proof tactic for unintended Admitted"

  - name: hypatia-scan-data-loss
    when: "verisim-data/scans/*.json corrupted or scan dispatch payload mangled"
    invariant: "scan files are append-only and signed via stapeln"
    run:
      - "git -C verisimdb-data log --diff-filter=D --name-only -- scans/"
      - "recover via git revert of the corrupting commit"
      - "panic-attack assail re-run if scan content lost"

# ----------------------------------------------------------------------
# What NOT to do (anti-patterns)
# ----------------------------------------------------------------------

anti-patterns:

  - name: do-not-rm-data-dir
    why: "WAL replay is idempotent (C7) — losing the WAL means losing recovery; never rm -rf the data dir"

  - name: do-not-bypass-drift-monitor
    why: "Direct modality writes that skip the drift_monitor create silent divergence; always route through verisim-octad"

  - name: do-not-bulk-edit-spdx
    why: "feedback_no_automated_licence_edits — manual per-file owner-only; bulk sweeps cause legal-integrity damage"

  - name: do-not-cherry-pick-formal-proofs
    why: "Foundation-pack proofs depend on a coherent invariant chain; cherry-picking individual theorems can break Print Assumptions"

  - name: do-not-share-fixed-port
    why: "Per README: consumer repositories should keep their own lightweight runtime profiles, not vendor verisimdb or share a single fixed local port"
